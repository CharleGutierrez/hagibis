{
  "mcpServers": {
    "duckduckgo": {
      "command": "duckduckgo-mcp-server",
      "args": [],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "fetch": {
      "command": "mcp-server-fetch",
      "args": [],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "git": {
      "command": "mcp-server-git",
      "args": [],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "puppeteer": {
      "command": "bunx",
      "args": ["puppeteer-mcp-server"],
      "env": {
        "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/google-chrome-stable"
      }
    },
    "filesystem": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-filesystem", "."]
    },
    "sequentialthinking": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-sequential-thinking"]
    },
    "time": {
      "command": "mcp-server-time",
      "args": [],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "github": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "curl": {
      "command": "bunx",
      "args": ["@247arjun/mcp-curl"]
    },
    "ast_grep": {
      "command": "ast-grep-mcp",
      "args": []
    },
    "context7": {
      "command": "bunx",
      "args": ["@upstash/context7-mcp"]
    },
    "memory": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-memory"]
    },
    "iconify": {
      "command": "bunx",
      "args": ["@pipeworx/mcp-iconify"]
    },
    "bundlephobia": {
      "command": "bunx",
      "args": ["@pipeworx/mcp-bundlephobia"]
    },
    "npm": {
      "command": "bunx",
      "args": ["@arvoretech/npm-registry-mcp"]
    },
    "mermaid": {
      "command": "bunx",
      "args": ["mermaid-mcp-server"]
    },
    "dns": {
      "command": "bunx",
      "args": ["@pipeworx/mcp-dns"]
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp"]
    },
    "mock_saas": {
      "command": "bunx",
      "args": ["@bachstudio/smb-mock-mcp", "stripe"]
    },
    "everything": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-everything"]
    },
    "sqlite": {
      "command": "bunx",
      "args": ["mcp-sqlite"]
    },
    "postgres": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-postgres", "postgresql://postgres:postgres@localhost:5432/postgres"]
    },
    "shadcn": {
      "command": "bunx",
      "args": ["@jpisnice/shadcn-ui-mcp-server"]
    },
    "chrome_devtools": {
      "command": "bunx",
      "args": ["chrome-devtools-mcp"]
    },
    "crates": {
      "command": "bunx",
      "args": ["@pipeworx/mcp-crates"]
    },
    "pypi": {
      "command": "bunx",
      "args": ["@pipeworx/mcp-pypi"]
    },
    "cloudflare": {
      "command": "bunx",
      "args": ["@cloudflare/mcp-server-cloudflare"]
    },
    "docker": {
      "command": "bunx",
      "args": ["mcp-docker-server"]
    },
    "firecrawl": {
      "command": "bunx",
      "args": ["firecrawl-mcp"]
    },
    "brave_search": {
      "command": "bunx",
      "args": ["@brave/brave-search-mcp-server"]
    },
    "duckdb": {
      "command": "bunx",
      "args": ["mcp-duckdb-local"]
    },
    "openapi": {
      "command": "bunx",
      "args": ["mcp-openapi-schema-explorer"]
    },
    "a11y_scanner": {
      "command": "bunx",
      "args": ["mcp-accessibility-scanner"]
    },
    "redis": {
      "command": "bunx",
      "args": ["@liangshanli/mcp-server-redis", "redis://localhost:6379"]
