    "mongodb": {
      "command": "bunx",
      "args": ["mcp-mongo-server", "mongodb://localhost:27017/app"]
    },
    "mysql": {
      "command": "bunx",
      "args": ["mysql-mcp", "mysql://root:root@localhost:3306/app"]
    },
    "mdn": {
      "command": "bunx",
      "args": ["mdn-mcp"]
    },
    "graphql": {
      "command": "bunx",
      "args": ["graphql-mcp", "http://localhost:4000/graphql"]
    },
    "sentry": {
      "command": "bunx",
      "args": ["mcp-server-sentry"]
    },
    "vercel": {
      "command": "bunx",
      "args": ["@antidrift/mcp-vercel"]
    },
    "image_tools": {
      "command": "bunx",
      "args": ["mcp-image"]
    },
    "office": {
      "command": "uvx",
      "args": ["libreoffice-mcp"]
    },
    "blender": {
      "command": "uvx",
      "args": ["mcp-for-blender"]
    }
  }
}
