// Hagibis Stateful WebAssembly Distributed Component Interface (WIT)
// Specification for multi-tier state migration across Local Engine and Edge Workers
package hagibis:kernel@0.2.0;

interface types {
    enum node-tier {
        local-desktop,
        edge-worker,
        cloud-firecracker,
    }

    enum sync-status {
        synchronized,
        diverging,
        migrating,
        halted,
    }

    record memory-page {
        offset: u32,
        size: u32,
        blake3-checksum: string,
        dirty: bool,
    }

    record execution-state {
        revision: u64,
        sequence: u64,
        node-id: string,
        active-tier: node-tier,
        status: sync-status,
        dirty-pages: list<memory-page>,
    }

    record migration-envelope {
        source-node: string,
        target-node: string,
        timestamp: u64,
        blake3-hash: string,
        compressed-payload: list<u8>,
        state: execution-state,
    }

    enum tensor-data-type {
        f32,
        f16,
        bf16,
        q8-0,
    }

    record tensor-header {
        name: string,
        dtype: tensor-data-type,
        shape: list<u32>,
        byte-length: u32,
        data-offset: u32,
    }

    /// Zero-Copy Shared Linear Memory Buffer Descriptor
    record shm-buffer-descriptor {
        shm-id: string,
        base-offset: u32,
        capacity-bytes: u32,
        head-offset: u32,
        tail-offset: u32,
        flags: u32,
    }
}

/// Zero-Copy WASM-to-Daemon IPC Interface
interface zero-copy-ipc {
    use types.{shm-buffer-descriptor, tensor-header};

    /// Attach shared linear memory buffer in guest space
    hgb-shm-attach: func(descriptor: shm-buffer-descriptor) -> result<_, string>;

    /// Read tensor header directly from attached shared memory
    hgb-shm-read-tensor-header: func() -> result<tensor-header, string>;

    /// Stream prompt token array directly to shared memory
    hgb-shm-write-token-stream: func(tokens: list<u32>) -> result<u32, string>;

    /// Allocate shared linear memory buffer in guest space
    shm-alloc: func(capacity: u32, flags: u32) -> result<shm-buffer-descriptor, string>;

    /// Read buffer descriptor for linear memory buffer at given guest offset
    shm-get-descriptor: func(offset: u32) -> result<shm-buffer-descriptor, string>;

    /// Process context buffer in-place with zero memory copy
    shm-process-context: func(descriptor: shm-buffer-descriptor) -> result<u32, string>;
}

interface state-sync {
    use types.{node-tier, sync-status, execution-state, migration-envelope};

    /// Checkpoint running Wasm linear memory & execution context
    checkpoint: func() -> result<execution-state, string>;

    /// Generate cryptographic state migration envelope for network transit
    serialize-snapshot: func() -> result<migration-envelope, string>;

    /// Ingest state migration envelope and resume execution seamlessly
    restore-snapshot: func(envelope: migration-envelope) -> result<execution-state, string>;

    /// Command live migration to target runtime tier (local <-> Cloudflare Workers)
    hot-swap-tier: func(target: node-tier) -> result<sync-status, string>;
}

interface executor {
    use types.{execution-state};

    /// Execute bytecode bounded by instruction step budget
    execute-step: func(instruction-budget: u64) -> result<u64, string>;

    /// Query JSON telemetry for telemetry monitoring
    query-telemetry: func() -> string;
}

world hagibis-wasm-engine {
    export state-sync;
    export executor;
    export zero-copy-ipc;
}
