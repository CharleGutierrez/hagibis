package hagibis:wasm-kernel@0.1.0;

/// Shared Memory and Zero-Copy Canonical ABI Definitions for Hagibis Sovereign Execution.
/// Eliminates serde/JSON serialization latency across sandboxed WASM microkernel components
/// and provides direct 64-byte aligned memory mappings for NPU and GPU neural routing.
interface canonical-abi-types {
    /// Access permissions for shared linear memory slices
    enum memory-access-mode {
        read-only,
        read-write,
        exclusive-write,
    }

    /// Memory capability permission level
    enum capability-permission {
        read-only,
        read-write,
    }

    /// Primitive data types supported in zero-copy shared memory and tensor views
    enum tensor-data-type {
        f32,
        f16,
        bf16,
        i32,
        i16,
        i8,
        u32,
        u16,
        u8,
        q8-0,
        q4-0,
    }

    /// Target hardware acceleration engine for pinned tensor routing
    enum npu-device-target {
        cpu-simd,
        npu-direct,
        gpu-compute,
        ephemeral-npu,
    }

    /// Functional usage role of a linear memory in multi-memory Wasmtime components
    enum memory-usage-role {
        private-heap,
        shared-shm-ring,
        tensor-dma,
        io-buffer,
    }

    /// Low-level slice into WebAssembly linear memory
    record canonical-memory-slice {
        ptr: u64,
        len: u64,
        alignment: u32,
        access-mode: memory-access-mode,
    }

    /// High-level typed shared memory descriptor for cross-component zero-copy exchange
    record typed-shm-view-descriptor {
        view-id: u64,
        slice: canonical-memory-slice,
        element-type: string,
        element-stride: u32,
        element-count: u64,
        version-epoch: u64,
        flags: u32,
    }

    /// Unforgeable memory capability token for fine-grained linear memory security
    record memory-capability-token {
        token-id: u64,
        memory-index: u32,
        view-id: u64,
        permission: capability-permission,
        nonce: u64,
        signature: list<u8>,
        allowed-offset: u64,
        allowed-len: u64,
    }

    /// Descriptor for multi-memory WebAssembly components (Wasmtime multi-memory)
    record linear-memory-descriptor {
        memory-index: u32,
        name: string,
        initial-pages: u32,
        maximum-pages: option<u32>,
        is-shared: bool,
        role: memory-usage-role,
        access-mode: memory-access-mode,
        size-bytes: u64,
    }

    /// 64-byte aligned Canonical ABI Invocation Header layout.
    /// Exchanged across component boundaries without serialization.
    record canonical-invocation-header {
        magic: u64,
        protocol-version: u32,
        action-code: u32,
        correlation-id: u64,
        payload-flags: u32,
        arg-offset: u32,
        arg-length: u32,
        return-offset: u32,
        return-capacity: u32,
        return-length: u32,
        status-code: u32,
        reserved-hi: u64,
        reserved-lo: u64,
    }

    /// Pinned tensor descriptor for zero-copy DMA and NPU tensor acceleration
    record pinned-tensor-descriptor {
        tensor-id: u64,
        shm-view-id: u64,
        dtype: tensor-data-type,
        shape: list<u64>,
        strides: list<u64>,
        byte-offset: u64,
        byte-length: u64,
        alignment: u32,
        device-target: npu-device-target,
        is-pinned: bool,
    }

    /// Action invocation payload bypassing serde JSON/bincode
    record canonical-abi-invocation-payload {
        header: canonical-invocation-header,
        input-slice: canonical-memory-slice,
        return-slice: canonical-memory-slice,
        pinned-tensor: option<pinned-tensor-descriptor>,
    }

    /// Zero-copy lock-free ring buffer descriptor for host-WASM memory conduit
    record shm-ring-buffer-descriptor {
        view-id: u64,
        ring-capacity: u32,
        element-size: u32,
        head-offset: u32,
        tail-offset: u32,
        buffer-offset: u32,
        mask: u32,
    }

    /// Fixed 24-byte zero-copy ring element header
    record shm-ring-element-header {
        sequence-number: u64,
        payload-length: u32,
        flags: u32,
        timestamp-ns: u64,
    }

    /// Single-Producer Single-Consumer (SPSC) ring buffer descriptor bounded by linear memory capping
    record spsc-ring-buffer-descriptor {
        view-id: u64,
        ring-capacity: u32,
        element-size: u32,
        head-offset: u32,
        tail-offset: u32,
        buffer-offset: u32,
        mask: u32,
        linear-memory-cap-bytes: u64,
        is-cache-padded: bool,
    }

    /// Fixed 32-byte zero-copy SPSC element header with checksum verification
    record spsc-ring-element-header {
        sequence-number: u64,
        payload-length: u32,
        flags: u32,
        timestamp-ns: u64,
        checksum: u32,
    }

    /// SPSC zero-copy dequeue pop result
    record spsc-pop-result {
        header: spsc-ring-element-header,
        payload-slice: canonical-memory-slice,
        sequence-number: u64,
    }

    /// Multi-Producer Single-Consumer (MPSC) ring buffer descriptor
    record mpsc-ring-buffer-descriptor {
        ring-id: u64,
        capacity: u32,
        element-size: u32,
        head-offset: u32,
        tail-offset: u32,
        flags: u32,
    }

    /// Multi-Producer Single-Consumer (MPSC) zero-copy element header with checksum verification
    record mpsc-ring-element-header {
        sequence-number: u64,
        producer-id: u64,
        payload-length: u32,
        flags: u32,
        timestamp-ns: u64,
        checksum: u32,
    }

    /// MPSC zero-copy dequeue pop result
    record mpsc-pop-result {
        header: mpsc-ring-element-header,
        payload-slice: canonical-memory-slice,
        sequence-number: u64,
    }

    /// Cryptographic manifest for verifying incoming WASM component/module integrity before instantiation
    record component-integrity-manifest {
        component-name: string,
        version: string,
        blake3-digest: list<u8>,
        ed25519-public-key: list<u8>,
        ed25519-signature: list<u8>,
        payload-byte-length: u64,
        fuel-budget: u64,
        max-memory-pages: u32,
    }

    /// Cryptographic validation outcome
    record cryptographic-verification-outcome {
        is-valid: bool,
        computed-blake3: list<u8>,
        signature-verified: bool,
        error-diagnostic: option<string>,
        verified-timestamp-ns: u64,
    }

    /// Cryptographically signed network permission token restricting outbound guest network access
    record network-permission-token {
        token-id: u64,
        allowed-hosts: list<string>,
        min-port: u16,
        max-port: u16,
        max-outbound-requests: u32,
        egress-bytes-limit: u64,
        nonce: u64,
        signature: list<u8>,
    }

    /// Atomic Compare-And-Swap (CAS) outcome record
    record atomic-cas-outcome {
        success: bool,
        previous-value: u64,
        current-value: u64,
    }

    /// Error variants encountered during zero-copy ABI view management
    variant abi-error {
        out-of-bounds(string),
        alignment-fault(string),
        borrow-conflict(string),
        double-lend(string),
        view-not-found(string),
        invalid-magic(u64),
        buffer-overflow(string),
        npu-routing-failed(string),
        execution-trapped(string),
        permission-denied(string),
        ring-full(string),
        ring-empty(string),
        invalid-capacity(string),
        io-uring-error(string),
        cryptographic-validation-failed(string),
        fuel-exhausted(string),
        epoch-interruption(string),
        linear-memory-cap-exceeded(string),
    }
}

/// Interface for linear memory lending, borrowing, and zero-copy action invocation
interface canonical-abi-shm {
    use canonical-abi-types.{
        canonical-memory-slice,
        typed-shm-view-descriptor,
        canonical-invocation-header,
        pinned-tensor-descriptor,
        canonical-abi-invocation-payload,
        abi-error,
        tensor-data-type,
        memory-access-mode,
        npu-device-target,
    };

    /// Lend a region of host or guest linear memory to a sub-component with borrow safety
    lend-memory: func(view: typed-shm-view-descriptor) -> result<u64, abi-error>;

    /// Reclaim a previously lent linear memory region, restoring exclusive owner control
    reclaim-memory: func(view-id: u64) -> result<_, abi-error>;

    /// Zero-copy action dispatch bypassing JSON/bincode serialization
    invoke-action: func(payload: canonical-abi-invocation-payload) -> result<canonical-abi-invocation-payload, abi-error>;

    /// Register and pin a tensor buffer for zero-copy NPU routing
    pin-tensor: func(desc: pinned-tensor-descriptor) -> result<u64, abi-error>;

    /// Unpin a tensor buffer from NPU routing table
    unpin-tensor: func(tensor-id: u64) -> result<_, abi-error>;

    /// Query metadata and active borrow state of a shared memory view
    query-view: func(view-id: u64) -> result<typed-shm-view-descriptor, abi-error>;
}

/// Lock-free, zero-copy producer-consumer ring buffer conduit interface.
/// Directly maps host memory pages into WASM linear memory with acquire-release semantics.
interface shm-ring-conduit {
    use canonical-abi-types.{
        canonical-memory-slice,
        shm-ring-buffer-descriptor,
        shm-ring-element-header,
        abi-error,
    };

    /// Result of popping an element from the zero-copy ring conduit
    record shm-ring-pop-result {
        header: shm-ring-element-header,
        payload-slice: canonical-memory-slice,
        sequence-number: u64,
    }

    /// Initialize a zero-copy lock-free ring buffer descriptor in linear memory
    create-ring: func(view-id: u64, ring-capacity: u32, element-size: u32) -> result<shm-ring-buffer-descriptor, abi-error>;

    /// Zero-copy enqueue operation into lock-free shared ring buffer
    push-zero-copy: func(ring-id: u64, header: shm-ring-element-header, payload: canonical-memory-slice) -> result<u64, abi-error>;

    /// Zero-copy dequeue operation from lock-free shared ring buffer
    pop-zero-copy: func(ring-id: u64) -> result<shm-ring-pop-result, abi-error>;

    /// Read current atomic head position
    ring-head: func(ring-id: u64) -> result<u64, abi-error>;

    /// Read current atomic tail position
    ring-tail: func(ring-id: u64) -> result<u64, abi-error>;

    /// Query available space or elements remaining in ring buffer
    ring-available: func(ring-id: u64) -> result<u32, abi-error>;
}

/// Lock-free Single-Producer Single-Consumer (SPSC) ring buffer interface operating over capped linear memory
interface spsc-ring-buffer {
    use canonical-abi-types.{
        canonical-memory-slice,
        spsc-ring-buffer-descriptor,
        spsc-ring-element-header,
        spsc-pop-result,
        atomic-cas-outcome,
        abi-error,
    };

    /// Initialize a lock-free SPSC ring buffer descriptor bounded by linear memory cap
    create-spsc-ring: func(view-id: u64, ring-capacity: u32, element-size: u32, linear-memory-cap-bytes: u64) -> result<spsc-ring-buffer-descriptor, abi-error>;

    /// Enqueue an element into the SPSC ring buffer with acquire/release ordering
    spsc-push: func(ring-id: u64, header: spsc-ring-element-header, payload: canonical-memory-slice) -> result<u64, abi-error>;

    /// Dequeue an element from the SPSC ring buffer with acquire/release ordering
    spsc-pop: func(ring-id: u64) -> result<spsc-pop-result, abi-error>;

    /// Read current atomic head position
    spsc-head: func(ring-id: u64) -> result<u64, abi-error>;

    /// Read current atomic tail position
    spsc-tail: func(ring-id: u64) -> result<u64, abi-error>;

    /// Query available ready elements in SPSC ring buffer
    spsc-available: func(ring-id: u64) -> result<u32, abi-error>;

    /// Query remaining write capacity before backpressure
    spsc-remaining-capacity: func(ring-id: u64) -> result<u32, abi-error>;

    /// Atomic Compare-And-Swap on SPSC ring head pointer with acquire-release ordering
    spsc-cas-head: func(ring-id: u64, expected: u64, desired: u64) -> result<atomic-cas-outcome, abi-error>;

    /// Atomic Compare-And-Swap on SPSC ring tail pointer with acquire-release ordering
    spsc-cas-tail: func(ring-id: u64, expected: u64, desired: u64) -> result<atomic-cas-outcome, abi-error>;

    /// Arbitrary 64-bit atomic Compare-And-Swap at aligned offset within shared memory view
    spsc-atomic-cas: func(view-id: u64, offset: u64, expected: u64, desired: u64) -> result<atomic-cas-outcome, abi-error>;
}

/// Strict cryptographic verification interface (BLAKE3 checksum + Ed25519 signature)
interface cryptographic-wit-validator {
    use canonical-abi-types.{
        component-integrity-manifest,
        cryptographic-verification-outcome,
        abi-error,
    };

    /// Strictly validate cryptographic checksum and signature on incoming component payload
    validate-component-payload: func(payload: list<u8>, manifest: component-integrity-manifest) -> result<cryptographic-verification-outcome, abi-error>;

    /// Compute 32-byte BLAKE3 cryptographic digest of input payload
    compute-blake3-digest: func(payload: list<u8>) -> list<u8>;

    /// Verify Ed25519 digital signature over input data
    verify-ed25519-signature: func(data: list<u8>, signature: list<u8>, public-key: list<u8>) -> result<bool, abi-error>;
}

/// Capability checker interface for validating unforgeable tokens and verifying memory permissions
interface capability-checker {
    use canonical-abi-types.{memory-capability-token, network-permission-token, capability-permission, abi-error};

    /// Validate that a memory capability token possesses a valid cryptographic signature
    verify-token: func(token: memory-capability-token) -> result<bool, abi-error>;

    /// Check if a capability token authorizes read-write mutation
    can-write: func(token: memory-capability-token) -> bool;

    /// Check if a capability token authorizes read-only access
    can-read: func(token: memory-capability-token) -> bool;

    /// Revoke an active capability token dynamically at runtime
    revoke-capability: func(token-id: u64, reason: string) -> result<bool, abi-error>;

    /// Check if a capability token has been revoked
    is-capability-revoked: func(token-id: u64) -> bool;

    /// Dynamically inject fine-grained memory capability token into running instance without restart
    inject-memory-token: func(instance-id: string, token: memory-capability-token) -> result<u64, abi-error>;

    /// Dynamically inject fine-grained network permission token into running instance without restart
    inject-network-token: func(instance-id: string, token: network-permission-token) -> result<u64, abi-error>;
}

/// Dedicated dynamic capability manager interface for zero-restart capability injection and instant revocation
interface dynamic-capability-manager {
    use canonical-abi-types.{memory-capability-token, network-permission-token, abi-error};

    /// Revoke an active capability token dynamically at runtime
    revoke-capability: func(token-id: u64, reason: string) -> result<bool, abi-error>;

    /// Check if a capability token has been revoked
    is-capability-revoked: func(token-id: u64) -> bool;

    /// Dynamically inject fine-grained memory capability token into running instance without restart
    inject-memory-token: func(instance-id: string, token: memory-capability-token) -> result<u64, abi-error>;

    /// Dynamically inject fine-grained network permission token into running instance without restart
    inject-network-token: func(instance-id: string, token: network-permission-token) -> result<u64, abi-error>;
}

/// Linux io_uring asynchronous shared memory bridge interface for zero-copy host-guest IPC.
/// Maps lock-free SQ (Submission Queue) and CQ (Completion Queue) ring buffers directly across
/// WASM linear memory boundaries (WebAssembly.Memory / ArrayBuffer) and registers pre-pinned
/// zero-copy buffers via IORING_REGISTER_BUFFERS.
interface io-uring-shm-bridge {
    use canonical-abi-types.{abi-error, memory-capability-token};

    /// Submission Queue Entry (SQE) descriptor for asynchronous zero-copy IO
    record io-uring-sqe-descriptor {
        opcode: u8,
        flags: u8,
        ioprio: u16,
        fd: s32,
        off: u64,
        addr: u64,
        len: u32,
        user-data: u64,
    }

    /// Completion Queue Entry (CQE) descriptor returning operation status and user metadata
    record io-uring-cqe-descriptor {
        user-data: u64,
        res: s32,
        flags: u32,
    }

    /// Zero-copy buffer registration descriptor for IORING_REGISTER_BUFFERS
    record io-uring-buffer-registration {
        buffer-id: u32,
        shm-handle: string,
        offset: u64,
        capacity: u64,
        page-size: u32,
        is-wasm-linear-memory: bool,
    }

    /// Lock-free zero-copy io_uring IPC channel spanning host kernel and WASM guest linear memory
    resource io-uring-shm-channel {
        /// Construct a new io_uring shared memory channel with specified queue depth and flags
        constructor(entries: u32, flags: u32);

        /// Submit batch of SQEs to the submission ring guarded by capability token
        submit: func(sqes: list<io-uring-sqe-descriptor>, token: memory-capability-token) -> result<u32, abi-error>;

        /// Poll and reap CQEs from the completion ring without blocking
        poll-completions: func(min-complete: u32, max-entries: u32) -> result<list<io-uring-cqe-descriptor>, abi-error>;

        /// Register shared memory buffers with the kernel for fixed-buffer zero-copy operations
        register-buffers: func(buffers: list<io-uring-buffer-registration>, token: memory-capability-token) -> result<u32, abi-error>;

        /// Unregister previously registered buffers, releasing pinned page references
        unregister-buffers: func(token: memory-capability-token) -> result<_, abi-error>;
    }
}

/// Zero-Copy WASM-to-NPU Streaming Pipeline interface for hardware-accelerated
/// GPU/NPU tensor buffers mapped directly into Wasm linear memory via shared memory handles.
interface wasm-npu-streaming-pipeline {
    use canonical-abi-types.{tensor-data-type, npu-device-target};

    /// Hardware-accelerated zero-copy GPU/NPU tensor buffer shared memory descriptor
    record npu-tensor-shm-descriptor {
        handle-id: u64,
        shm-name: string,
        offset-bytes: u64,
        size-bytes: u64,
        alignment: u32,
        data-type: tensor-data-type,
        dimensions: list<u64>,
        device-target: npu-device-target,
        is-coherent: bool,
    }

    /// Allocate or register a zero-copy hardware NPU tensor buffer in shared memory
    create-npu-tensor-buffer: func(desc: npu-tensor-shm-descriptor) -> result<u64, string>;

    /// Map a host pinned shared memory tensor buffer directly into WASM linear memory
    map-wasm-linear-memory: func(handle-id: u64, wasm-ptr: u64, size: u64) -> result<bool, string>;

    /// Flush or invalidate DMA CPU/NPU caches across the shared memory range
    flush-dma-cache: func(handle-id: u64, offset: u64, size: u64) -> result<bool, string>;

    /// Dispatch a batched zero-copy tensor compute operation directly against the shared buffer
    submit-zero-copy-batch: func(handle-id: u64, operation: string) -> result<u64, string>;
}

/// The Hagibis Canonical Interop World
world canonical-interop {
    import canonical-abi-shm;
    import capability-checker;
    import dynamic-capability-manager;
    import shm-ring-conduit;
    import spsc-ring-buffer;
    import cryptographic-wit-validator;
    import io-uring-shm-bridge;
    import wasm-npu-streaming-pipeline;
    export canonical-abi-shm;
    export capability-checker;
    export dynamic-capability-manager;
    export shm-ring-conduit;
    export spsc-ring-buffer;
    export cryptographic-wit-validator;
    export io-uring-shm-bridge;
    export wasm-npu-streaming-pipeline;
}
